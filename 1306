class Solution {
    public boolean canReach(int[] arr, int start) {
        int n = arr.length;
        Queue<Integer> queue = new ArrayDeque<>();
        queue.offer(start);

        while (!queue.isEmpty()) {
            int curr = queue.poll();

            if (arr[curr] == 0) {
                return true;
            }
            if (arr[curr] < 0) {
                continue;
            }

            int jump = arr[curr];
            arr[curr] = -1; // Mark index as visited

            if (curr + jump < n) {
                queue.offer(curr + jump);
            }
            if (curr - jump >= 0) {
                queue.offer(curr - jump);
            }
        }

        return false;
    }
}
